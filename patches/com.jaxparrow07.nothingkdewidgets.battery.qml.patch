+    // Battery presence check. The engine is asked each tick and the counting
+    // happens here, so the "PC mode" verdict does not depend on a signal that
+    // may never arrive. Stops as soon as the question is answered.
+    Timer {
+        interval: 5000
+        running: root.batteryLoading
+        repeat: true
+        onTriggered: {
+            var d = pmSource.data["Battery"]
+            if (d !== undefined) {
+                root.handlePowerData(d)
+            } else if (root.batteryCheckAttempts < root.maxBatteryCheckAttempts) {
+                root.batteryCheckAttempts++
+            } else {
+                root.batteryLoading = false
+                root.isPCMode = true
+                root.hasBattery = false
+            }
+        }
+    }
+
     // Font loader for ndot-55
     FontLoader {
         id: ndotFont
         source: Qt.resolvedUrl("../fonts/ndot-55.otf")
     }
 
+    // The powermanagement engine is push-based: onNewData fires only when a
+    // Solid signal does (presentStateChanged, chargePercentChanged, ...). On a
+    // machine with no battery none of those ever fire, so this handler never
+    // ran and the loading spinner -- whose only exit is "6 unanswered ticks" --
+    // spun forever. The Timer below is now what decides "no battery".
+    function handlePowerData(data) {
+        var hasBat = data["Has Battery"] || false
+
+        if (hasBat) {
+            root.batteryCheckAttempts = 0
+            root.hasBattery = true
+            root.batteryLoading = false
+            root.isPCMode = false
+        } else {
+            if (root.batteryCheckAttempts < root.maxBatteryCheckAttempts) {
+                root.batteryCheckAttempts++
+            } else {
+                root.batteryLoading = false
+                root.isPCMode = true
+            }
+            root.hasBattery = false
+        }
+
+        root.batteryPercent = data["Percent"] || 0
+        root.batteryState = data["State"] || ""
+        root.energyRate = Math.abs(data["Energy Rate"] || 0)
+        root.isBatterySaver = data["Battery Save Mode"] || false
+    }
+
